# Primary deck & script generation — Anthropic (recommended for production)
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Ask the Assistant help chat (keep on Gemini Flash) + generate fallback
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GEMINI_MAX_OUTPUT_TOKENS_PRACTICE=4096
GEMINI_MAX_OUTPUT_TOKENS_ASSISTANT=512
MAX_ASSISTANT_MESSAGES=40
MAX_ASSISTANT_MESSAGE_CHARS=4000
MAX_REQUEST_BYTES=15000000

# Rate limits (on by default)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GENERATE_MAX=24
# RATE_LIMIT_GENERATE_WINDOW=3600
# RATE_LIMIT_ASSISTANT_MAX=40
# RATE_LIMIT_ASSISTANT_WINDOW=300
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW=300

# Optional error monitoring
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Client build (Vite)
# VITE_SITE_URL=https://revise.appstax.ai
# VITE_SENTRY_DSN=

# --- EdStack shared wallet ---
# BILLING_ENABLED=true
# AUTH_SECRET=<shared>
# EDSTACK_BILLING_URL=https://account.appstax.ai
# EDSTACK_BILLING_SERVICE_SECRET=<shared>
# EDSTACK_APP_ID=audio-revision-coach
# SESSION_COOKIE_DOMAIN=.appstax.ai
# AUTH_COOKIE_SECURE=true
# APP_PUBLIC_URL=https://revise.appstax.ai
